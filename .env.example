ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:localdevpassword@localhost:5433/enterprise_rag
POSTGRES_PASSWORD=localdevpassword
DATABASE_URL_CONTAINER=postgresql+psycopg://postgres:localdevpassword@db:5432/enterprise_rag
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REDIS_URL=redis://localhost:6379/0

LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_COMPLETION_TOKENS=800
MAX_CONTEXT_CHARS=12000

DOCUMENT_STORAGE_DIR=storage/documents
MAX_DOCUMENT_SIZE_BYTES=10485760
DOCUMENT_PROCESSING_WORKER_CONCURRENCY=2
DOCUMENT_PROCESSING_LEASE_SECONDS=3600
DOCUMENT_TASK_SOFT_TIME_LIMIT_SECONDS=1500
DOCUMENT_TASK_TIME_LIMIT_SECONDS=1800
DOCUMENT_WORKER_MAX_MEMORY_PER_CHILD_KB=2000000
WORKER_MEMORY_LIMIT=4g
WORKER_CPU_LIMIT=2

CONVERSATION_HISTORY_MAX_MESSAGES=10
CONVERSATION_HISTORY_MAX_CHARS=8000
CONVERSATION_RETENTION_DAYS=90
CONVERSATION_REQUEST_LEASE_SECONDS=900

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_SEARCH_REQUESTS=60
RATE_LIMIT_ASK_REQUESTS=20
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_RETRY_REQUESTS=10
REDIS_TIMEOUT_SECONDS=1
METRICS_RETENTION_SECONDS=2592000

# Supply a JSON array of explicit trusted origins for a browser frontend.
CORS_ALLOWED_ORIGINS=[]
